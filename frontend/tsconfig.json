{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    /* TODO(P3-7): enable noUncheckedIndexedAccess once ScaleBand
       indexing in MapView.tsx and NetworkLink.tsx, plus useTheme order[]
       indexing, are guarded. Trial run produced 27 errors (>20). */
    /* "noUncheckedIndexedAccess": true, */
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src"]
}

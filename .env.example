# =============================================================================
# Netmap NG Configuration
# =============================================================================
# Copy this file to .env and fill in the values.
# All variables can also be set as system environment variables.

# --- App -------------------------------------------------------------------

# REQUIRED: Session signing key (minimum 16 characters)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
APP_SECRET_KEY=

# Public URL of the backend (used for OAuth callbacks and secure cookie detection)
APP_BASE_URL=http://localhost:8000

# Set to true ONLY for local development without OIDC authentication.
# Without DEV_ALLOW_NO_AUTH=true AND APP_BASE_URL on localhost, this flag is
# ignored and a startup warning is emitted.
AUTH_DISABLED=false
DEV_ALLOW_NO_AUTH=false

# Expose Swagger UI / ReDoc / OpenAPI at /docs, /redoc, /openapi.json.
# Default: false. Enable only on internal/admin deployments.
EXPOSE_DOCS=false

# CORS origins (comma-separated). Add your frontend URL here.
# '*' is forbidden when credentials are enabled. http origins are rejected
# when APP_BASE_URL is not on localhost.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# SQLAlchemy database URL for map storage (default: SQLite in current directory)
APP_DB_URL=sqlite+aiosqlite:///./data/netmap.db

# --- Sessions --------------------------------------------------------------
# Server-side session store. Sessions are kept in Redis and the cookie holds
# only an opaque session id.

SESSION_REDIS_URL=redis://localhost:6379/0
# Idle timeout (seconds) before the session is rotated/expired.
SESSION_IDLE_SECONDS=1800
# Absolute lifetime (seconds). After this the user must re-authenticate.
SESSION_ABSOLUTE_SECONDS=28800

# --- CSRF ------------------------------------------------------------------
CSRF_COOKIE_NAME=csrf_token
CSRF_HEADER_NAME=X-CSRF-Token

# --- OIDC Authentication ---------------------------------------------------
# Configure your identity provider below. The recommended approach is to set
# OAUTH_DISCOVERY_URL — the server fetches the OIDC metadata document and uses
# its jwks_uri / issuer values to verify ID tokens. If you cannot use
# discovery, set OAUTH_JWKS_URL + OAUTH_ISSUER + OAUTH_AUDIENCE manually.

# OIDC client credentials from your identity provider
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=

# Preferred: OIDC discovery URL (e.g. https://idp/.well-known/openid-configuration)
OAUTH_DISCOVERY_URL=

# Alternative manual configuration (used when discovery is not set)
OAUTH_JWKS_URL=
OAUTH_ISSUER=
OAUTH_AUDIENCE=

# OIDC endpoints (provider-specific). Required when discovery is not used.
OAUTH_AUTHORIZE_URL=
OAUTH_TOKEN_URL=
OAUTH_USERINFO_URL=

# OIDC scopes to request
OAUTH_SCOPES=openid profile email

# --- OIDC Roles (optional) -------------------------------------------------
# Role-based access control via OIDC claims.
# An unset OAUTH_EDITOR_ROLE / OAUTH_ADMIN_ROLE never grants access — the
# matching role must be explicitly configured AND present on the user.

OAUTH_EDITOR_ROLE=
OAUTH_ADMIN_ROLE=

# Name of the claim in the OIDC token that contains user roles
# For Entra ID: "roles"
# For Keycloak: "realm_access.roles" or a custom mapper
OAUTH_ROLES_CLAIM=roles

# --- Observium MySQL (read-only) -------------------------------------------
# Connection to your Observium database for live traffic data.

OBSERVIUM_DB_HOST=observium.local
OBSERVIUM_DB_PORT=3306
OBSERVIUM_DB_USER=netmap_ro
OBSERVIUM_DB_PASSWORD=
OBSERVIUM_DB_NAME=observium

# --- Observium RRD path ----------------------------------------------------
# Path to Observium's RRD files for historical traffic graphs.

OBSERVIUM_RRD_PATH=/opt/observium/rrd
